                                    <constraint firstAttribute="height" constant="102" id="tcl-8r-utu"/>
                                </constraints>
                                <textFieldCell key="cell" id="w2b-Km-CYo">
                                    <font key="font" metaFont="smallSystem"/>
                                    <string key="title">Note for Windows 11 ARM users:

The virtual machine is created with "Ram framebuffer standalone device". This is required to install Windows 11 correctly on the VM. Once Windows gets installed, the "VirtIO GPU PCI" adapter can be selected. This adapter works better and offers the possibility to select the screen resolution, if you install the proper driver. The driver can be found in the DVD that you find attached to the VM when you create it.</string>
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <textField focusRingType="none" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" translatesAutoresizingMaskIntoConstraints="NO" id="kMz-L0-DKD">
                                <rect key="frame" x="18" y="342" width="564" height="28"/>
                                <textFieldCell key="cell" selectable="YES" id="Y41-Tk-1j6">
                                    <font key="font" metaFont="smallSystem"/>
                                    <string key="title">The VM is created with a default video adapter, but various adapters can work in your VM, depending on the emulated hardware and the guest operating system. Here you can change the video adapter to use:</string>
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <textField focusRingType="none" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" translatesAutoresizingMaskIntoConstraints="NO" id="Cvm-OW-d8w">
                                <rect key="frame" x="18" y="197" width="564" height="28"/>
                                <textFieldCell key="cell" selectable="YES" id="vVx-QY-Ml8">
                                    <font key="font" metaFont="smallSystem"/>
                                    <string key="title">MacMulator can try to enable 3D acceleration in the guest VM, if it detects that the underlying Qemu supporrts it. This might bmake teh VM unstable.</string>
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="bHD-eX-M1v">
