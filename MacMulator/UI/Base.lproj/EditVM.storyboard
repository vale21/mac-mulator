        <!--Video-->
        <scene sceneID="zfE-CJ-cVq">
            <objects>
                <viewController title="Video" id="bME-KN-L8y" customClass="EditVMViewControllerVideo" customModule="MacMulator" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" id="43X-1U-j2N">
                        <rect key="frame" x="0.0" y="0.0" width="600" height="390"/>
